# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CRM_ENCRYPTION_KEY: 32-byte hex or passphrase used to encrypt customer PII (Mobile, PAN, Address) at rest.
CRM_ENCRYPTION_KEY="change-this-in-production-to-a-strong-32-byte-secret"

# CRM_DB_PATH: Path to centralized SQLite database file.
CRM_DB_PATH="./data/ambika_crm.db"
